{
  "description": "Identidade: o corretor com as permissões de cotação e seleção e o operador com as permissões de operação. O frontend controla a navegação por permissions; o backend continua responsável pela autorização.",
  "exchanges": [
    {
      "name": "corretor",
      "request": {
        "method": "GET",
        "path": "/v1/me"
      },
      "response": {
        "status": 200,
        "body": {
          "userId": "3b1f2c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
          "displayName": "ana-writer",
          "organizationId": "org-acme",
          "permissions": [
            "quotes:read",
            "quotes:write",
            "offers:select"
          ]
        }
      }
    },
    {
      "name": "operador",
      "request": {
        "method": "GET",
        "path": "/v1/me"
      },
      "response": {
        "status": 200,
        "body": {
          "userId": "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
          "displayName": "olga-operator",
          "organizationId": "org-acme",
          "permissions": [
            "operations:read",
            "operations:reconcile"
          ]
        }
      }
    }
  ]
}
