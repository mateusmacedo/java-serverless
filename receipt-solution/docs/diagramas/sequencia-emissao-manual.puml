@startuml sequencia-emissao-manual
!include ../../../docs/diagramas/tema-plataforma.iuml
hide stereotype
title $I_API Emissão manual: POST /receipts
autonumber
participant "$I_CLIENTE\nCliente HTTP" as cliente <<ator>>
box "Entrada" #FFFAF3
    participant "$I_API\nAPI Gateway" as gw <<entrada>>
    participant "$I_LAMBDA\napi\n(ReceiptResource)" as api <<entrada>>
end box
box "Aplicação" #F5FAFF
    participant "$I_MAQUINA\nreceipt-flow" as sfn <<aplicacao>>
end box

cliente -> gw : POST /receipts\n{requestId, signature, payloadBytes}
gw -> api : evento proxy
alt #FFEBEE Content-Type diferente de application/json
    api --> cliente : <color:#C62828>415 sem corpo</color>
else #FFEBEE campo ausente ou em branco, ou payloadBytes < 1
    api --> cliente : <color:#C62828>400 com a lista de violações, sem iniciar execução</color>
else #E8F5E9 ok
    api -> sfn : StartExecution(input = {"detail": corpo})\nsem nome: a AWS gera um
    api --> cliente : <color:#2E7D32>202 {requestId, executionArn}</color>
end
note over sfn
  Segue igual à emissão por evento
  (sequencia-emissao-por-evento.puml):
  Issue idempotente e Announce. Emitir de novo
  um requestId existente devolve o mesmo
  comprovante e publica ReceiptIssued outra vez.
end note
$legenda_erros()
@enduml
