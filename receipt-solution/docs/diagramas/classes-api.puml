@startuml classes-api
!include ../../../docs/diagramas/tema-plataforma.iuml
set separator none
hide empty members
hide stereotype
title $I_API Pacote com.mmda.serverless.receipt.api (módulo receipt-api)

package "com.mmda.serverless.receipt.api" {
    class ReceiptResource <<porta>> {
        - dynamoDb : DynamoDbClient
        - sfn : SfnClient
        - objectMapper : ObjectMapper
        - config : ReceiptApiConfig
        + find(requestId : String) : Response
        + issue(request : IssueReceiptRequest) : Response
        - toJson(value : Object) : String
    }
    class "ReceiptResource.IssueAccepted" as IssueAccepted <<valor>> {
        requestId : String
        executionArn : String
    }
    class IssueReceiptRequest <<valor>> {
        @NotBlank requestId : String
        @NotBlank signature : String
        @NotNull @Positive payloadBytes : Long
    }
    class Receipt <<valor>> {
        requestId : String
        signature : String
        payloadBytes : Long
        issuedAt : String
        ~ {static} fromItem(item : Map<String, AttributeValue>) : Receipt
    }
    interface ReceiptApiConfig <<porta>> {
        tableName() : String
        stateMachineArn() : String
    }
}

ReceiptResource --> ReceiptApiConfig
ReceiptResource ..> IssueReceiptRequest : corpo do POST (@Valid @NotNull)
ReceiptResource ..> IssueAccepted : corpo do 202
ReceiptResource ..> Receipt : corpo do 200

note right of ReceiptResource
  @Path("/receipts")
  GET /{requestId}: GetItem consistente; 404 sem item
  POST: StartExecution com {"detail": request}
end note
note bottom of ReceiptApiConfig
  @ConfigMapping(prefix = "receipt")
  TABLE_NAME e STATE_MACHINE_ARN
end note
note bottom of Receipt
  Cópia do record do receipt-functions:
  mesmos nomes de atributos do item
end note

legend right
    <b>Leitura</b>
    <back:#FFF3E0>    </back> Entrada (resource) e configuração
    <back:#F1F8E9>    </back> Registro de dados (record)
endlegend
@enduml
