@startuml modelo-dynamodb
!include ../../../docs/diagramas/tema-plataforma.iuml
hide circle
hide stereotype
skinparam linetype ortho
title $I_DYNAMODB receipt-solution — modelo de dados (DynamoDB)

package "DynamoDB: receipt-solution-<stage>-receipts (PAY_PER_REQUEST, sem índices, sem stream, sem TTL)" #F6FBF6 {
    entity "$I_DYNAMODB <b>Comprovante</b>\nReceipt.toItem() no receipt-functions" as item <<dominio>> {
        * requestId : S <<PK, HASH>>
        --
        signature : S (copiada do RequestCompleted)
        payloadBytes : N
        issuedAt : S (ISO-8601 UTC, Instant.now(clock))
    }
}

package "Formas de acesso" #F7F9FA {
    entity "<b>issue</b> (IssueReceiptHandler)" as escrita <<infra>> {
        PutItem com attribute_not_exists(requestId)
        GetItem consistentRead, quando a condição falha
    }
    entity "<b>api</b> (ReceiptResource.find)" as leitura <<infra>> {
        GetItem consistentRead pela chave
    }
}

escrita --> item : grava uma vez
leitura --> item : lê

note bottom of item
  O mesmo formato de item é lido por dois records Receipt,
  um em cada módulo (api e functions); os nomes dos
  atributos precisam bater nos dois.
end note

legend right
    <b>Leitura</b>
    <back:#E8F5E9>    </back> Item do DynamoDB
    <back:#ECEFF1>    </back> Quem acessa e como
    S = texto, N = número (tipos do DynamoDB)
    Só requestId é declarado no AttributeDefinitions
endlegend
@enduml
