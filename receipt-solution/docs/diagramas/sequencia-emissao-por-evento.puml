@startuml sequencia-emissao-por-evento
!include ../../../docs/diagramas/tema-plataforma.iuml
hide stereotype
title $I_EVENTBRIDGE Emissão por evento: RequestCompleted da sample-solution
autonumber
box "Outra solução" #FFF5F8
    participant "$I_LAMBDA\nnotify\n(sample-solution)" as notify <<externo>>
    participant "$I_EVENTBRIDGE\nsample-solution-\n<stage>-events" as samplebus <<externo>>
end box
box "Aplicação" #F5FAFF
    participant "$I_MAQUINA\nreceipt-flow" as sfn <<aplicacao>>
    participant "$I_LAMBDA\nissue\n(IssueReceiptHandler)" as issue <<aplicacao>>
    participant "$I_LAMBDA\nannounce\n(AnnounceReceiptHandler)" as announce <<aplicacao>>
end box
box "Infraestrutura" #F7F9FA
    database "$I_DYNAMODB\nreceipt-solution-\n<stage>-receipts" as ddb <<infra>>
end box
box "Saída" #FBF6FC
    participant "$I_EVENTBRIDGE\nreceipt-solution-\n<stage>-events" as bus <<saida>>
end box

notify -> samplebus : PutEvents source mmda.sample,\ndetail-type RequestCompleted
samplebus ->> sfn : regra da receipt-solution: StartExecution\ncom o evento inteiro (nome gerado)
== Issue (InputPath $.detail, Retry States.ALL: 2 novas tentativas, 2 s, backoff 2) ==
sfn -> issue : CompletedRequest {requestId, signature, payloadBytes}\n(campos desconhecidos ignorados)
issue -> ddb : PutItem com ConditionExpression\nattribute_not_exists(requestId)
alt #E8F5E9 primeiro evento do requestId
    ddb --> issue : <color:#2E7D32>ok</color>
    issue --> sfn : Receipt com issuedAt = agora (UTC)
else #FFF3E0 evento repetido (entrega pelo menos uma vez)
    ddb --> issue : ConditionalCheckFailedException
    issue -> ddb : GetItem consistentRead
    issue --> sfn : Receipt já emitido (mesmo issuedAt)
end
== Announce (Retry igual ao do Issue) ==
sfn -> announce : Receipt
announce -> bus : PutEvents source mmda.receipt,\ndetail-type ReceiptIssued, detail = Receipt
alt #FFEBEE FailedEntryCount > 0 ou erro depois das novas tentativas
    announce --> sfn : <color:#C62828>IllegalStateException</color>
    sfn -> sfn : <color:#C62828>FAILED, sem Catch e sem DLQ</color>
else #E8F5E9 ok
    announce --> sfn : Receipt
    sfn -> sfn : <color:#2E7D32>SUCCEEDED</color>
end
note over announce, bus : Um evento repetido publica ReceiptIssued de novo,\ncom o mesmo comprovante
$legenda_camadas()
@enduml
