@startuml classes-functions
!include ../../../docs/diagramas/tema-plataforma.iuml
set separator none
hide empty members
hide stereotype
title $I_LAMBDA Pacote com.mmda.serverless.receipt.functions (módulo receipt-functions)

package "com.mmda.serverless.receipt.functions" {
    interface "RequestHandler<I, O>" as Handler
    class IssueReceiptHandler <<serviço>> {
        - dynamoDb : DynamoDbClient
        - config : ReceiptConfig
        - clock : Clock
        + handleRequest(request : CompletedRequest, context : Context) : Receipt
    }
    class AnnounceReceiptHandler <<serviço>> {
        ~ {static} EVENT_SOURCE = "mmda.receipt"
        ~ {static} EVENT_DETAIL_TYPE = "ReceiptIssued"
        - eventBridge : EventBridgeClient
        - objectMapper : ObjectMapper
        - config : ReceiptConfig
        + handleRequest(receipt : Receipt, context : Context) : Receipt
    }
    class CompletedRequest <<valor>> {
        requestId : String
        signature : String
        payloadBytes : Long
    }
    class Receipt <<valor>> {
        requestId : String
        signature : String
        payloadBytes : Long
        issuedAt : String
        ~ toItem() : Map<String, AttributeValue>
        ~ {static} fromItem(item : Map<String, AttributeValue>) : Receipt
    }
    interface ReceiptConfig <<porta>> {
        tableName() : String
        eventBusName() : String
    }
    class ClockProducer <<serviço>> {
        ~ clock() : Clock
    }
}

Handler <|.. IssueReceiptHandler
Handler <|.. AnnounceReceiptHandler
IssueReceiptHandler ..> CompletedRequest : entrada
IssueReceiptHandler ..> Receipt : saída
AnnounceReceiptHandler ..> Receipt : entrada, saída e detail
IssueReceiptHandler --> ReceiptConfig
AnnounceReceiptHandler --> ReceiptConfig
ClockProducer ..> IssueReceiptHandler : Clock.systemUTC()

note top of IssueReceiptHandler : @Singleton @Named("issue")
note top of AnnounceReceiptHandler : @Singleton @Named("announce")
note bottom of CompletedRequest : @JsonIgnoreProperties(ignoreUnknown = true)\ndetail do RequestCompleted da sample-solution
note bottom of ReceiptConfig : @ConfigMapping(prefix = "receipt")\nTABLE_NAME e EVENT_BUS_NAME

legend right
    <b>Leitura</b>
    <back:#E3F2FD>    </back> Handler escolhido por QUARKUS_LAMBDA_HANDLER e produtor CDI
    <back:#F1F8E9>    </back> Registro de dados (record)
    <back:#FFF3E0>    </back> Configuração
endlegend
@enduml
