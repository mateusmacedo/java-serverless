@startuml implantacao-floci
!include ../../../docs/diagramas/tema-plataforma.iuml
!$LEGEND_TITLE_TEXT = "Legenda"
!include <C4/C4_Deployment>

UpdateElementStyle("node", $bgColor="#F7F9FA", $fontColor="#37474F", $borderColor="#455A64", $legendText="Nó de implantação")
UpdateElementStyle("person", $bgColor="#FFFDE7", $fontColor="#37474F", $borderColor="#F9A825", $legendText="Ator")
UpdateElementStyle("container", $bgColor="#ECEFF1", $fontColor="#37474F", $borderColor="#455A64", $legendText="Stack de solução (CloudFormation emulado)")
AddElementTag("plataforma", $bgColor="#F3E5F5", $fontColor="#37474F", $borderColor="#6A1B9A", $legendText="Stack da plataforma")
AddElementTag("ferramenta", $bgColor="#FFF3E0", $fontColor="#37474F", $borderColor="#EF6C00", $legendText="Ferramenta de implantação")
AddRelTag("ordem", $textColor="#1565C0", $lineColor="#1565C0", $legendText="Ordem do deploy:local")
AddRelTag("evento", $textColor="#6A1B9A", $lineColor="#6A1B9A", $lineStyle=DashedLine(), $legendText="Regra que liga as stacks pelo nome do barramento")

title $I_FLOCI Plataforma — implantação no Floci (stage local, pnpm deploy:local)

Person(dev, "Desenvolvedor", "docker compose up -d e pnpm deploy:local", $sprite="user_cog")

Deployment_Node(host, "Máquina do desenvolvedor", "Docker, JDK 21, Maven 3.9, Node.js e pnpm", $sprite="docker") {
    Container(mvn, "mvn -B -q package -DskipTests", "Maven", "Gera os zips de todas as Lambdas", $tags="ferramenta")
    Container(sls, "Serverless Framework v4", "serverless-localstack, ativo só no stage local", "Um sls deploy --stage local por pasta, para localhost:4566", $tags="ferramenta")
    Deployment_Node(floci, "floci", "floci/floci:2.4.0, porta 4566, rede floci, volume floci-data") {
        Container(platform, "1. platform-local", "platform/events", "Barramento platform-local-events", $sprite="exchange_alt", $tags="plataforma")
        Container(provider, "2. provider-solution-local", "provider-solution", "3 regras no barramento da plataforma", $sprite="leaf")
        Container(quote, "3. quote-solution-local", "quote-solution", "2 regras no barramento da plataforma", $sprite="cubes")
    }
}

Rel(dev, mvn, "pnpm deploy:local")
Rel(mvn, sls, "depois do package")
Rel(sls, platform, "deploy:platform", $tags="ordem")
Rel(platform, provider, "deploy:provider", $tags="ordem")
Rel(provider, quote, "deploy:quote", $tags="ordem")
Rel_U(provider, platform, "Regras source mmda.quote", $tags="evento")
Rel_U(quote, platform, "Regras source mmda.provider", $tags="evento")

SHOW_LEGEND()
@enduml
