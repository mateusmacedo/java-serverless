@startuml c4-componente-workers
!include ../../../docs/diagramas/tema-plataforma.iuml
!include <C4/C4_Component>

!$LEGEND_TITLE_TEXT = "Legenda"
UpdateElementStyle("external_system", $bgColor="#FCE4EC", $fontColor="#37474F", $borderColor="#AD1457", $legendText="Fornecedor simulado")
UpdateElementStyle("container", $bgColor="#ECEFF1", $fontColor="#37474F", $borderColor="#455A64", $legendText="Recurso AWS")
UpdateElementStyle("component", $bgColor="#E3F2FD", $fontColor="#37474F", $borderColor="#1565C0", $legendText="Componente do provider-functions")
UpdateBoundaryStyle($bgColor="#FFFFFF", $fontColor="#37474F", $borderColor="#90A4AE", $legendText="Limite das Lambdas")
AddElementTag("entrada", $bgColor="#FFF3E0", $fontColor="#37474F", $borderColor="#EF6C00", $legendText="Função escolhida por SPRING_CLOUD_FUNCTION_DEFINITION")
AddElementTag("saida", $bgColor="#F3E5F5", $fontColor="#37474F", $borderColor="#6A1B9A", $legendText="Adaptador AWS ou HTTP")
AddElementTag("dominio", $bgColor="#E8F5E9", $fontColor="#37474F", $borderColor="#2E7D32", $legendText="Regra da provider-domain")
AddRelTag("assincrono", $textColor="#6A1B9A", $lineColor="#6A1B9A", $lineStyle=DashedLine(), $legendText="Assíncrono (SQS)")

title $I_LAMBDA enrichmentWorker, insurerWorker e reconcileWorker — componentes (C4 nível 3)

ContainerQueue(requests, "enrichment-requests, insurer-requests, reconcile-requests", "SQS, lote 1", "Envelope do EventBridge com o pedido no detail", $sprite="inbox")
System_Ext(sims, "simulators (via API Gateway)", "POST /sim/enrichment/profiles, /sim/insurers/alpha/quotes, /sim/insurers/beta/quotes; GET da situação da beta", $sprite="robot")

Boundary(functions, "provider-functions", "3 Lambdas, timeout 25 s (workerTimeoutSeconds), papel compartilhado") {
    Component(entries, "EnrichmentWorkerFunction, InsurerWorkerFunction, ReconcileWorkerFunction", "Function<SQSEvent, SQSBatchResponse>", "SqsBatches: cada mensagem isolada; a que falha volta em batchItemFailures", $sprite="bolt", $tags="entrada")
    Component(enrichment, "EnrichmentRequestHandler", "Serviço", "Reentrega, prazo, ReusePlan (HIT, JOIN, liderança) em até 5 rodadas, chamada com retries", $sprite="cubes")
    Component(insurer, "InsurerRequestHandler", "Serviço", "Tabela de reentrega, prazo, rota do insurerId, quota, chamada, 202 e conclusão", $sprite="building")
    Component(reconcile, "ReconcileRequestHandler", "Serviço", "OPERATION# RUNNING, dono da consulta, reconciliação e resultado com QueryReconciled", $sprite="user_cog")
    Component(resolutions, "EnrichmentResolutions", "Serviço", "Conclusão do líder, HIT, JOIN, consulta interrompida e fan-out", $sprite="project_diagram")
    Component(queryrec, "QueryReconciliation", "Serviço", "Mesmo caminho do reconciler, para uma consulta e sem teto de leituras", $sprite="clock")
    Component(pending, "PendingCallbacks e CallbackLedger", "DynamoDB", "Metade do worker no CORR# e processamento dos callbacks pendentes", $sprite="inbox", $tags="saida")
    Component(ledger, "QueryLedger", "DynamoDB", "QUERY#, ATTEMPT#, EVIDENCE#, QUOTA#, FANOUT, CONSUMED#", $sprite="database", $tags="saida")
    Component(reuse, "ReuseLedger", "DynamoDB", "REUSE#, INFLIGHT# e FOLLOWER#", $sprite="database", $tags="saida")
    Component(operations, "OperationLedger e OperationIssues", "DynamoDB", "OPERATION# e ISSUE#, cada mudança com o próprio outbox", $sprite="database", $tags="saida")
    Component(outbox, "OutboxStore e Transactions", "DynamoDB", "OUTBOX# na transação do efeito; TransactionConflict repetido até 3 vezes", $sprite="paper_plane", $tags="saida")
    Component(clients, "ProviderClients e ProviderHttp", "java.net.http, sem retry", "Timeout de 5 s, HTTP/1.1, sem redirecionamento", $sprite="globe", $tags="saida")
    Component(raw, "RawResponses", "S3", "raw/{queryId}/{nnnn}.json, callback-*.json e status-{nnnn}.json", $sprite="archive", $tags="saida")
    Component(redelivery, "DelayedRedelivery", "SQS", "Reenvio com DelaySeconds (até 900 s) preservando o dlqAttempt", $sprite="inbox", $tags="saida")
    Component(keysecret, "QueryKeySecret", "Secrets Manager", "query-key-secret da queryKey", $sprite="key", $tags="saida")
    Component(metrics, "Metrics", "EMF na saída padrão", "ProviderCalls e ProviderFailures por Stage e Provider", $sprite="bell", $tags="saida")
    Component(domain, "ReusePlan, EnrichmentProtocol, InsurerProtocol, InsurerStatus, RetryPolicy, QuotaWindow, QueryKeys, Identities", "provider-domain", "Decisões puras, sem SDK", $sprite="leaf", $tags="dominio")
}

ContainerDb(queries, "provider-solution-{stage}-queries", "DynamoDB", "Tabela de consultas", $sprite="database")
ContainerDb(payloads, "provider-solution-{stage}-payloads", "S3", "Respostas brutas", $sprite="archive")
Container(sm, "provider-solution/{stage}/query-key-secret", "Secrets Manager", "Chave HMAC", $sprite="key")

Rel(requests, entries, "SQSEvent", "ESM", $tags="assincrono")
Rel(entries, enrichment, "enrichmentWorker")
Rel(entries, insurer, "insurerWorker")
Rel(entries, reconcile, "reconcileWorker")
Rel(enrichment, domain, "plano, classificação, retry, quota")
Rel(insurer, domain, "classificação, retry, quota")
Rel(enrichment, resolutions, "settle, publishHit, publishRecorded, redoFanOut")
Rel(enrichment, reuse, "reuseEntry, leadership, register")
Rel(enrichment, keysecret, "value()")
Rel(insurer, pending, "meet(provider, providerRequestId, queryId)")
Rel(reconcile, operations, "start, finish")
Rel(reconcile, queryrec, "reconcile(query)")
Rel(queryrec, resolutions, "settleInterrupted")
Rel(queryrec, pending, "meet")
Rel(resolutions, ledger, "settleAsLeader, settle, resolve")
Rel(resolutions, reuse, "complete, putReuse, followers")
Rel(enrichment, ledger, "load, lead, reserveNext, finishAttempt")
Rel(insurer, ledger, "load, reserveFirst, reserveNext, recordAccepted, settle")
Rel(ledger, outbox, "OUTBOX# e TransactWriteItems")
Rel(pending, ledger, "conclusão do callback")
Rel(enrichment, clients, "fetchProfile")
Rel(insurer, clients, "requestQuote")
Rel(queryrec, clients, "insurerStatus")
Rel(clients, sims, "HTTP", "PROVIDERS_BASE_URL")
Rel(enrichment, raw, "store")
Rel(insurer, raw, "store")
Rel(enrichment, redelivery, "quota esgotada ou entrega viva")
Rel(insurer, redelivery, "quota esgotada ou entrega viva")
Rel(redelivery, requests, "SendMessage com DelaySeconds", "SQS", $tags="assincrono")
Rel(enrichment, metrics, "providerCall")
Rel(insurer, metrics, "providerCall")
Rel(outbox, queries, "TransactWriteItems")
Rel(reuse, queries, "GetItem, Query, TransactWriteItems")
Rel(raw, payloads, "PutObject")
Rel(keysecret, sm, "GetSecretValue")

SHOW_LEGEND()
@enduml
