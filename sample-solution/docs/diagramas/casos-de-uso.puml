@startuml casos-de-uso
!include ../../../docs/diagramas/tema-plataforma.iuml
title $I_SPRING Casos de uso da sample-solution
left to right direction
hide stereotype

actor "$I_CLIENTE\nCliente HTTP" as cliente
actor "$I_OPERADOR\nDesenvolvedor" as dev
actor "$I_AGENDADOR\nEventBridge Scheduler" as scheduler
actor "$I_EVENTBRIDGE\nreceipt-solution\n(regra no barramento)" as receipt

package "$I_SPRING sample-solution" as sample <<aplicacao>> {
    usecase "Registrar requisição\n(POST /requests, api)" as UC_registrar
    usecase "Validar e assinar o payload\n(validate)" as UC_validar <<sistema>>
    usecase "Persistir o resultado\n(persist)" as UC_persistir <<sistema>>
    usecase "Notificar a conclusão\n(notify: SNS e RequestCompleted)" as UC_notificar <<sistema>>
    usecase "Enviar a falha para a DLQ\n(SendToDeadLetterQueue)" as UC_dlq <<sistema>>
    usecase "Reprocessar a DLQ\n(reprocess)" as UC_reprocessar
    usecase "Descartar após maxAttempts\n(log WARN)" as UC_descartar <<sistema>>
    usecase "Consultar a requisição\n(get-item na tabela requests)" as UC_consultar <<leitura>>
}

cliente --> UC_registrar
dev --> UC_reprocessar : lambda invoke
scheduler --> UC_reprocessar : a cada 5 minutos
dev --> UC_consultar
UC_registrar ..> UC_validar : <<include>>\n(assíncrono, request-flow)
UC_validar ..> UC_persistir : <<include>>
UC_persistir ..> UC_notificar : <<include>>
UC_dlq ..> UC_validar : <<extend>>\nerro em qualquer passo
UC_descartar ..> UC_reprocessar : <<extend>>\nattempt >= maxAttempts
UC_reprocessar ..> UC_validar : <<include>>\nnova execução
UC_notificar --> receipt : RequestCompleted

note right of UC_consultar
  Não há rota de consulta: a API só tem
  POST /requests. O estado se acompanha pela
  execução, pela tabela e pela DLQ.
end note

legend right
    <b>Leitura</b>
    <back:#E3F2FD>    </back> Caso iniciado por um ator
    <back:#ECEFF1>    </back> Caso executado pelo sistema (máquina de estado)
    <back:#E8F5E9>    </back> Leitura sem efeito
endlegend
@enduml
