@startuml classes-functions
!include ../../../docs/diagramas/tema-plataforma.iuml
set separator none
hide empty members
hide stereotype
title $I_LAMBDA Pacote com.mmda.serverless.sample.functions (módulo functions)

package "com.mmda.serverless.sample.functions" {
    interface "Function<T, R>" as Fn
    class ValidateFunction <<serviço>> {
        - {static} HMAC_ALGORITHM = "HmacSHA256"
        + apply(request : RequestContext) : RequestContext
        - {static} sign(key : String, content : byte[]) : String
    }
    class PersistFunction <<serviço>> {
        + apply(request : RequestContext) : RequestContext
    }
    class NotifyFunction <<serviço>> {
        ~ {static} EVENT_SOURCE = "mmda.sample"
        ~ {static} EVENT_DETAIL_TYPE = "RequestCompleted"
        + apply(request : RequestContext) : RequestContext
    }
    class ReprocessFunction <<serviço>> {
        + apply(command : ReprocessCommand) : ReprocessResult
        - restart(retry : RequestContext) : void
    }
    class RequestContext <<valor>> {
        requestId : String
        s3Key : String
        attempt : int
        signature : String
        payloadBytes : Long
        ~ validated(payloadSignature : String, size : long) : RequestContext
        ~ nextAttempt() : RequestContext
    }
    class ReprocessCommand <<valor>> {
        maxMessages : Integer
        - {static} SQS_MAX_BATCH = 10
        ~ batchSize() : int
    }
    class ReprocessResult <<valor>> {
        restarted : int
        discarded : int
    }
    class FunctionsProperties <<valor>> {
        bucketName, tableName, topicArn,
        eventBusName, deadLetterQueueName,
        stateMachineArn, maxPayloadParameter,
        signingSecretId : String
        maxAttempts : int
    }
    class InvalidRequestException <<exceção>>
    class FunctionsApplication <<serviço>>
}

Fn <|.. ValidateFunction
Fn <|.. PersistFunction
Fn <|.. NotifyFunction
Fn <|.. ReprocessFunction
ValidateFunction ..> RequestContext
PersistFunction ..> RequestContext
NotifyFunction ..> RequestContext
ReprocessFunction ..> ReprocessCommand
ReprocessFunction ..> ReprocessResult
ReprocessFunction ..> RequestContext : lê o corpo da DLQ
ValidateFunction ..> InvalidRequestException : lança
ValidateFunction --> FunctionsProperties
PersistFunction --> FunctionsProperties
NotifyFunction --> FunctionsProperties
ReprocessFunction --> FunctionsProperties

note top of ValidateFunction : @Component("validate")\nS3Client, SsmClient, SecretsManagerClient
note top of PersistFunction : @Component("persist")\nDynamoDbClient
note top of NotifyFunction : @Component("notify")\nSnsClient, EventBridgeClient
note top of ReprocessFunction : @Component("reprocess")\nSqsClient, SfnClient
note bottom of FunctionsProperties : @ConfigurationProperties(prefix = "sample")\nmaxAttempts = ${MAX_ATTEMPTS:3}
note bottom of RequestContext : nextAttempt() soma 1 em attempt\ne zera signature e payloadBytes

legend right
    <b>Leitura</b>
    <back:#E3F2FD>    </back> Função registrada como bean (nome = SPRING_CLOUD_FUNCTION_DEFINITION)
    <back:#F1F8E9>    </back> Registro de dados (record)
    <back:#FFEBEE>    </back> Exceção que leva a execução para a DLQ
endlegend
@enduml
