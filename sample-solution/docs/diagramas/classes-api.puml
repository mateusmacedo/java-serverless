@startuml classes-api
!include ../../../docs/diagramas/tema-plataforma.iuml
set separator none
hide empty members
hide stereotype
title $I_API Pacote com.mmda.serverless.sample.api (módulo api)

package "com.mmda.serverless.sample.api" {
    class StreamLambdaHandler <<porta>> {
        - {static} HANDLER : SpringBootLambdaContainerHandler<AwsProxyRequest, AwsProxyResponse>
        + handleRequest(input : InputStream, output : OutputStream, context : Context) : void
    }
    class ApiApplication <<serviço>> {
        + {static} main(args : String[]) : void
    }
    class RequestController <<porta>> {
        - s3 : S3Client
        - sfn : SfnClient
        - objectMapper : ObjectMapper
        - properties : ApiProperties
        ~ create(payload : String) : ResponseEntity<RequestAccepted>
    }
    class "RequestController.ExecutionInput" as ExecutionInput <<valor>> {
        requestId : String
        s3Key : String
        attempt : int
    }
    class "RequestController.RequestAccepted" as RequestAccepted <<valor>> {
        requestId : String
        executionArn : String
    }
    class ApiProperties <<valor>> {
        bucketName : String
        stateMachineArn : String
    }
}

package "com.mmda.serverless.platform.spring.aws (spring-aws)" #F7F9FA {
    class AwsClientsAutoConfiguration <<serviço>>
}

interface RequestStreamHandler
RequestStreamHandler <|.. StreamLambdaHandler
StreamLambdaHandler ..> ApiApplication : getAwsProxyHandler(ApiApplication.class)\nno bloco estático
RequestController --> ApiProperties
RequestController ..> ExecutionInput : entrada da execução
RequestController ..> RequestAccepted : corpo do 202
AwsClientsAutoConfiguration ..> RequestController : S3Client e SfnClient

note right of RequestController
  @RestController @RequestMapping("/requests")
  @PostMapping(consumes = application/json)
  s3Key = requests/<requestId>.json; requestId = UUID aleatório
end note
note bottom of ApiProperties
  @ConfigurationProperties(prefix = "sample")
  BUCKET_NAME e STATE_MACHINE_ARN
end note

legend right
    <b>Leitura</b>
    <back:#FFF3E0>    </back> Entrada (handler da Lambda e controller)
    <back:#E3F2FD>    </back> Aplicação Spring e autoconfiguração
    <back:#F1F8E9>    </back> Registro de dados (record)
endlegend
@enduml
