@startuml implantacao-floci
!include ../../../docs/diagramas/tema-plataforma.iuml
!$LEGEND_TITLE_TEXT = "Legenda"
!include <C4/C4_Deployment>

UpdateElementStyle("node", $bgColor="#F7F9FA", $fontColor="#37474F", $borderColor="#455A64", $legendText="Nó de implantação")
UpdateElementStyle("person", $bgColor="#FFFDE7", $fontColor="#37474F", $borderColor="#F9A825", $legendText="Ator")
UpdateElementStyle("container", $bgColor="#1565C0", $fontColor="#FFFFFF", $borderColor="#0D47A1", $legendText="Lambda Java 21 (Spring)")
AddElementTag("emulado", $bgColor="#ECEFF1", $fontColor="#37474F", $borderColor="#455A64", $legendText="Recurso emulado pelo Floci")
AddElementTag("ferramenta", $bgColor="#FFF3E0", $fontColor="#37474F", $borderColor="#EF6C00", $legendText="Ferramenta de implantação ou execução")

title $I_FLOCI sample-solution — implantação no Floci (stage local)

Person(dev, "Desenvolvedor", "docker compose up -d, mvn -B package e pnpm deploy:sample", $sprite="user_cog")

Deployment_Node(host, "Máquina do desenvolvedor", "Docker com o daemon rodando, JDK 21, Node.js e pnpm", $sprite="docker") {
    Container(sls, "Serverless Framework v4", "serverless-localstack e serverless-step-functions", "sls deploy --stage local para localhost:4566; envia api-lambda.zip e functions-lambda.zip", $tags="ferramenta")
    Container(offline, "serverless-offline (opcional)", "porta 3000, useDocker, rede floci", "Executa só a api e a rota HTTP; depende da implantação no Floci", $tags="ferramenta")
    Deployment_Node(compose, "Docker Compose mmda-serverless", "rede floci") {
        Deployment_Node(floci, "floci", "floci/floci:2.4.0, porta 4566, FLOCI_HOSTNAME=floci, dados persistentes no volume floci-data") {
            Container(stack, "Stack sample-solution-local", "CloudFormation emulado", "API local-sample-solution, request-flow, payloads, requests, dlq, audit, notifications, events, parâmetro SSM e segredo", $tags="emulado")
            Container(scheduler, "Agendamento do reprocess", "EventBridge Scheduler emulado", "rate(5 minutes)", $tags="emulado")
        }
        Deployment_Node(ui, "floci-ui", "floci/floci-ui:0.7.0, porta 4500") {
            Container(console, "Console web", "localhost:4500", "Tabelas, filas, funções, execuções e logs", $tags="ferramenta")
        }
        Deployment_Node(lambdas, "Contêineres das Lambdas", "public.ecr.aws/lambda/java:21, criados pelo Floci pelo socket do Docker") {
            Container(api, "api", "api-lambda.zip", "StreamLambdaHandler")
            Container(fns, "validate, persist, notify e reprocess", "functions-lambda.zip", "FunctionInvoker + SPRING_CLOUD_FUNCTION_DEFINITION")
        }
    }
}

Rel(dev, sls, "pnpm deploy:sample")
Rel(sls, stack, "CloudFormation", "localhost:4566")
Rel(stack, api, "Invoca pela integração do API Gateway")
Rel(stack, fns, "Invoca pelos estados da request-flow")
Rel(scheduler, fns, "Invoca o reprocess")
Rel(api, stack, "S3 e Step Functions", "AWS_ENDPOINT_URL aponta para floci:4566")
Rel(fns, stack, "S3, SSM, Secrets Manager, DynamoDB, SNS, EventBridge, SQS e Step Functions", "AWS_ENDPOINT_URL aponta para floci:4566")
Rel(console, stack, "Lê", "floci:4566")
Rel(offline, stack, "Usa os recursos implantados", "rede floci")

SHOW_LEGEND()
@enduml
