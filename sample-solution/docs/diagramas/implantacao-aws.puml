@startuml implantacao-aws
!include ../../../docs/diagramas/tema-plataforma.iuml
!$LEGEND_TITLE_TEXT = "Legenda"
!include <C4/C4_Deployment>

UpdateElementStyle("node", $bgColor="#F7F9FA", $fontColor="#37474F", $borderColor="#455A64", $legendText="Nó de implantação")
UpdateElementStyle("person", $bgColor="#FFFDE7", $fontColor="#37474F", $borderColor="#F9A825", $legendText="Ator")
UpdateElementStyle("container", $bgColor="#1565C0", $fontColor="#FFFFFF", $borderColor="#0D47A1", $legendText="Lambda Java 21 (Spring)")
AddElementTag("gerenciado", $bgColor="#ECEFF1", $fontColor="#37474F", $borderColor="#455A64", $legendText="Serviço gerenciado da AWS")
AddElementTag("pendente", $bgColor="#FFEBEE", $fontColor="#37474F", $borderColor="#C62828", $legendText="Não preparado para a AWS")

title $I_LAMBDA sample-solution — implantação na AWS (topologia alvo, não verificada)

Person(dev, "Desenvolvedor", "sls deploy --stage <stage>", $sprite="user_cog")

Deployment_Node(conta, "Conta AWS", "região us-east-1, fixa em provider.region") {
    Deployment_Node(cfn, "Stack sample-solution-<stage>", "CloudFormation gerado pelo Serverless Framework v4") {
        Container(apigw, "API <stage>-sample-solution", "API Gateway REST, estágio <stage>", "POST /requests, sem autorizador", $tags="gerenciado")
        Container(api, "sample-solution-<stage>-api", "Lambda java21, 1769 MB, 29 s", "api-lambda.zip")
        Container(fns, "sample-solution-<stage>-validate, -persist, -notify e -reprocess", "Lambda java21, 1769 MB, 60 s", "functions-lambda.zip")
        Container(sfn, "sample-solution-<stage>-request-flow", "Step Functions Standard", "Papel gerado pelo serverless-step-functions", $tags="gerenciado")
        Container(sched, "Agendamento do reprocess", "EventBridge Scheduler", "rate(5 minutes)", $tags="gerenciado")
        Container(dados, "payloads, requests, dlq, audit, notifications e events", "S3, DynamoDB, SQS, SNS e EventBridge", "Nomes sample-solution-<stage>-<sufixo>", $tags="gerenciado")
        Container(cfg, "/sample-solution/<stage>/max-payload-bytes e sample-solution/<stage>/signing-key", "SSM Parameter Store e Secrets Manager", "", $tags="gerenciado")
        Container(logs, "/aws/lambda/sample-solution-<stage>-<função>", "CloudWatch Logs", "Sem logRetentionInDays no serverless.yml", $tags="gerenciado")
    }
    Deployment_Node(deploybucket, "Bucket de implantação do Serverless", "serverless-framework-deployments-us-east-1-<id>") {
        Container(zips, "api-lambda.zip e functions-lambda.zip", "artefatos", "Enviados pelo nome do arquivo", $tags="gerenciado")
    }
}

Container(params, "params do stage", "serverless.yml", "Só existe params.local: sem valor para awsEndpointUrl e s3PathStyleAccess em outro stage", $tags="pendente")

Rel(dev, cfn, "sls deploy")
Rel(dev, params, "Precisa declarar antes")
Rel(apigw, api, "Lambda proxy")
Rel(api, sfn, "StartExecution")
Rel(sfn, fns, "Invoca validate, persist e notify")
Rel(sched, fns, "Invoca o reprocess")
Rel(fns, dados, "SDK v2 com AwsCrtHttpClient")
Rel(fns, cfg, "GetParameter e GetSecretValue")
Rel(api, dados, "PutObject")
Rel(api, logs, "stdout")
Rel(fns, logs, "stdout")
Rel(zips, api, "Código")
Rel(zips, fns, "Código")

SHOW_LEGEND()
@enduml
