@startuml sequencia-reprocessamento
!include ../../../docs/diagramas/tema-plataforma.iuml
hide stereotype
title $I_AGENDADOR Reprocessamento da DLQ: reprocess a cada 5 minutos
autonumber
participant "$I_AGENDADOR\nEventBridge Scheduler\nou desenvolvedor" as gatilho <<ator>>
box "Aplicação" #F5FAFF
    participant "$I_LAMBDA\nreprocess\n(ReprocessFunction)" as reprocess <<aplicacao>>
    participant "$I_MAQUINA\nrequest-flow" as sfn <<aplicacao>>
end box
box "Infraestrutura" #F7F9FA
    queue "$I_DLQ\nsample-solution-\n<stage>-dlq" as dlq <<infra>>
end box

gatilho -> reprocess : ReprocessCommand {maxMessages: 10}
note right of reprocess : batchSize = maxMessages limitado a 1..10;\nnulo vira 10 (ReprocessCommand)
reprocess -> dlq : GetQueueUrl(DEAD_LETTER_QUEUE_NAME)
reprocess -> dlq : ReceiveMessage(maxNumberOfMessages = batchSize)
loop para cada mensagem recebida
    reprocess -> reprocess : lê o corpo como RequestContext
    alt #E8F5E9 attempt < maxAttempts (MAX_ATTEMPTS, padrão 3)
        reprocess -> sfn : <color:#2E7D32>StartExecution(name = requestId-(attempt+1),</color>\n<color:#2E7D32>attempt + 1, signature e payloadBytes nulos)</color>
    else #FFEBEE attempt >= maxAttempts
        reprocess -> reprocess : <color:#C62828>log WARN "Discarding request ... after ... attempts"</color>
    end
    reprocess -> dlq : DeleteMessage(receiptHandle)
end
reprocess --> gatilho : ReprocessResult {restarted, discarded}
note over reprocess, dlq
  Um payload que sempre falha roda nas tentativas 1, 2 e 3
  (execuções requestId, requestId-2 e requestId-3) e é
  descartado quando a mensagem da tentativa 3 volta à DLQ (ADR 0007).
end note
$legenda_erros()
@enduml
