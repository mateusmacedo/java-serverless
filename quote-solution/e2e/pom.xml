<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mmda.serverless</groupId>
        <artifactId>quote-solution</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>quote-e2e</artifactId>

    <properties>
        <e2e.endpoint>http://localhost:4566</e2e.endpoint>
        <e2e.stage>local</e2e.stage>
        <e2e.region>us-east-1</e2e.region>
        <!-- N do T06 no Floci; o caso de 100 pedidos fica na integração da provider-functions -->
        <e2e.concurrentQuotes>12</e2e.concurrentQuotes>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- WHY: o T22 confere cada troca do e2e contra o contracts/openapi.yaml, o mesmo arquivo do frontend -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>openapi-request-validator-core</artifactId>
            <version>${openapi-request-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apigateway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cognitoidentityprovider</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sfn</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventbridge</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatchlogs</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*E2E.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!-- WHY: o módulo não sobe o Quarkus, então volta ao LogManager padrão do JUL -->
                        <java.util.logging.manager>java.util.logging.LogManager</java.util.logging.manager>
                        <aws.region>${e2e.region}</aws.region>
                        <e2e.stage>${e2e.stage}</e2e.stage>
                        <e2e.concurrentQuotes>${e2e.concurrentQuotes}</e2e.concurrentQuotes>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- NOTE: padrão, contra o Floci; desliga sozinho quando outro perfil deste pom é ativado -->
        <profile>
            <id>floci</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <aws.endpointUrl>${e2e.endpoint}</aws.endpointUrl>
                                <aws.accessKeyId>test</aws.accessKeyId>
                                <aws.secretAccessKey>test</aws.secretAccessKey>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- WHY: contra uma conta AWS (-Pe2e,e2e-aws), as três propriedades do Floci não podem existir nem vazias: o
             SDK trataria "" como endpoint, e as credenciais test venceriam a cadeia padrão (AWS_PROFILE ou SSO) -->
        <profile>
            <id>e2e-aws</id>
            <properties>
                <e2e.stage>dev</e2e.stage>
            </properties>
        </profile>
    </profiles>
</project>
